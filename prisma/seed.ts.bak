    basePrice: 120000,
    categoryId: pakaianWanita.id,
    imageUrl: 'https://picsum.photos/seed/rok-plisket-midi/600/600',
    variants: [
      { sku: 'RPM-BLK-M', color: 'Hitam', size: 'M', stock: 11 },
      { sku: 'RPM-BEI-M', color: 'Beige', size: 'M', stock: 13 },
    ],
  })

  await upsertProduct({
    name: 'Cardigan Rajut',
    slug: 'cardigan-rajut',
    description: 'Cardigan rajut lembut, cocok dipakai di cuaca dingin atau ber-AC.',
    basePrice: 135000,
    categoryId: pakaianWanita.id,
    imageUrl: 'https://picsum.photos/seed/cardigan-rajut/600/600',
    variants: [
      { sku: 'CR-CRM-S', color: 'Cream', size: 'S', stock: 10 },
      { sku: 'CR-CRM-M', color: 'Cream', size: 'M', stock: 12 },
      { sku: 'CR-GRY-M', color: 'Abu-abu', size: 'M', stock: 8 },
