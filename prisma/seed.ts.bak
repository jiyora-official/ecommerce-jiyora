    description: 'Kaos polos bahan katun combed 30s, nyaman dipakai sehari-hari.',
    basePrice: 85000,
    categoryId: pakaianPria.id,
    imageUrl: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600',
    variants: [
      { sku: 'KPP-BLK-M', color: 'Hitam', size: 'M', stock: 20 },
      { sku: 'KPP-BLK-L', color: 'Hitam', size: 'L', stock: 15 },
      { sku: 'KPP-WHT-M', color: 'Putih', size: 'M', stock: 10 },
    ],
  })

  // Kategori baru untuk 5 produk tambahan
  const pakaianWanita = await upsertCategory('Pakaian Wanita', 'pakaian-wanita')

  await upsertProduct({
    name: 'Blouse Wanita Katun',
