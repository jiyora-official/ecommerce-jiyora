    variants: [
      { sku: 'DCM-BLK-S', color: 'Hitam', size: 'S', stock: 10 },
      { sku: 'DCM-BLK-M', color: 'Hitam', size: 'M', stock: 14 },
      { sku: 'DCM-NVY-M', color: 'Navy', size: 'M', stock: 9 },
