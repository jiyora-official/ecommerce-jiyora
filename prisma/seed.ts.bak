import { PrismaClient } from '@prisma/client'
import { PrismaPg } from '@prisma/adapter-pg'
import 'dotenv/config'

const adapter = new PrismaPg({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false },
})
const prisma = new PrismaClient({ adapter })

async function upsertCategory(name: string, slug: string) {
  return prisma.category.upsert({
    where: { slug },
    update: {},
    create: { name, slug },
  })
}

async function upsertProduct(params: {
  name: string
  slug: string
  description: string
  basePrice: number
  categoryId: string
  imageUrl: string
  variants: { sku: string; color: string; size: string; stock: number }[]
}) {
  const existing = await prisma.product.findUnique({ where: { slug: params.slug } })
  if (existing) {
    console.log(`Produk "${params.name}" sudah ada, dilewati.`)
    return existing
  }
  return prisma.product.create({
    data: {
      name: params.name,
      slug: params.slug,
      description: params.description,
      basePrice: params.basePrice,
      categoryId: params.categoryId,
      images: { create: [{ url: params.imageUrl, isPrimary: true }] },
      variants: { create: params.variants },
    },
  })
}

async function main() {
  // Kategori lama tetap dipertahankan (dipakai produk pertama)
  const pakaianPria = await upsertCategory('Pakaian Pria', 'pakaian-pria')

  await upsertProduct({
    name: 'Kaos Polos Premium',
